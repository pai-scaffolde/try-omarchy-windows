  * Memory support.
  */
 
+typedef DWORD (WINAPI *WhpxDiscardVirtualMemory)(PVOID address, SIZE_T size);
+
+static WhpxDiscardVirtualMemory whpx_discard_virtual_memory(void)
+{
+    static WhpxDiscardVirtualMemory discard;
+    static bool resolved;
+
+    /* Windows 8.1 and later. The build targets an older API level, so the
+     * prototype is not declared; resolve it once at run time instead.
+     */
+    if (!resolved) {
+        HMODULE kernel32 = GetModuleHandleW(L"kernel32.dll");
+
+        if (kernel32) {
+            discard = (WhpxDiscardVirtualMemory)(void (*)(void))
+                GetProcAddress(kernel32, "DiscardVirtualMemory");
+        }
+        resolved = true;
+    }
+    return discard;
+}
+
+void whpx_report_free_pages(hwaddr gpa, void *host, size_t size)
+{
+    static uint64_t failures;
+    WhpxDiscardVirtualMemory discard;
+    MemoryRegionSection section;
+    MemoryRegion *mr;
+    RAMBlock *rb;
+    size_t page_size = qemu_real_host_page_size();
+    DWORD err;
+
+    assert(bql_locked());
+    if (!size || !QEMU_IS_ALIGNED(gpa | (uintptr_t)host | size, page_size)) {
+        return;
+    }
+
+    /* Only QEMU-owned, private, writable anonymous RAM can be safely
+     * discarded. The complete GPA range must resolve to these host pages.
+     * Leave file-backed, external, ROM and dirty-logged memory alone.
+     */
+    section = memory_region_find(get_system_memory(), gpa, size);
+    mr = section.mr;
+    if (!mr) {
+        return;
+    }
+    rb = mr->ram_block;
+    if (!memory_region_is_ram(mr) || mr->readonly || mr->rom_device ||
+        memory_region_is_ram_device(mr) || !rb || rb->fd >= 0 ||
+        (rb->flags & (RAM_SHARED | RAM_PREALLOC)) ||
+        memory_region_get_dirty_log_mask(mr) ||
+        int128_get64(section.size) != size ||
+        section.offset_within_address_space != gpa ||
+        memory_region_get_ram_ptr(mr) + section.offset_within_region != host) {
+        memory_region_unref(mr);
+        return;
+    }
+
+    /* The guest has surrendered these free pages until the report is
+     * returned, and the caller has already ruled out a guest that asked for
+     * them to keep a poison value. Give their physical pages back to Windows
+     * in place. The range stays committed and stays mapped at its GPA, so
+     * the reclaim never needs commit charge back and cannot leave the guest
+     * with an invalid mapping. A later access sees either the old contents
+     * or zeroes, both valid for a free page.
+     *
+     * A failure here only means the pages stay resident: log it, sparingly,
+     * and let the report be returned as usual. The guest waits for every
+     * report it sends, so it must always be returned.
+     */
+    discard = whpx_discard_virtual_memory();
+    err = discard ? discard(host, size) : ERROR_PROC_NOT_FOUND;
+    if (err != ERROR_SUCCESS && is_power_of_2(++failures)) {
+        warn_report("WHPX free-page discard failed: %lu "
+                    "(%" PRIu64 " failures, pages stay resident)",
+                    (unsigned long)err, failures);
+    }
+    memory_region_unref(mr);
+}
